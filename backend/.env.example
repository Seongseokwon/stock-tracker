# Finnhub API 키 — https://finnhub.io 에서 무료 발급
FINNHUB_API_KEY=your_finnhub_api_key_here

# PostgreSQL 연결 URL (로컬 Docker: npm run db:up 후 설정)
# 없으면 기존 환경변수(AUTH_CODE) 방식으로 동작
DATABASE_URL=postgresql://stockpulse:localdev@127.0.0.1:5433/stockpulse

# 서버 포트 (기본 3000)
PORT=3000

# 로그인 인증 코드 (대소문자 무시)
# 쉼표로 구분해 여러 코드 등록 가능 — 그 중 하나가 입력되면 로그인 허용
AUTH_CODE=SP-DEMO-0000,SP-USER-0001

# 세션 쿠키 서명 비밀키 (프로덕션에서는 반드시 변경)
SESSION_SECRET=change-me-in-production

# 관리자 API 비밀키 — POST /api/admin/codes 접근 시 x-admin-secret 헤더로 전달
ADMIN_SECRET=change-me-admin-secret

# 코드 요청 시스템 (로그인 코드 요청 → Slack 알림 + 이메일/즉시 수신)
# Slack Incoming Webhook URL — api.slack.com/apps 에서 발급
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# Gmail SMTP 발신 계정 + 앱 비밀번호 (myaccount.google.com → 보안 → 앱 비밀번호)
GMAIL_USER=sample@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# 백엔드 URL (Slack 알림 승인 curl 명령에 사용)
BACKEND_URL=https://stock-tracker-production-7e54.up.railway.app
